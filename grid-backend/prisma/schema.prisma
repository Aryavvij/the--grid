// The Grid — Prisma Schema
// Run `npm run db:generate` after changes
// Run `npm run db:migrate` to create a migration

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled URL (port 6543) — used at runtime
  directUrl = env("DIRECT_URL") // Supabase direct URL (port 5432) — used for migrations
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  googleId         String?   @unique @map("google_id")
  passwordHash     String?   @map("password_hash")
  // Sandbox ("demo") accounts: real rows, real API path, no signup friction.
  // Claimable into a permanent account; prunable once expired.
  isSandbox        Boolean   @default(false) @map("is_sandbox")
  sandboxExpiresAt DateTime? @map("sandbox_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  profile          UserProfile?
  habits           Habit[]
  habitLogs        HabitLog[]
  metricDefs       MetricDef[]
  metricLogs       MetricLog[]
  timetableBlocks  TimetableBlock[]
  weeklyTasks      WeeklyTask[]
  studySessions    StudySession[]
  gymSplits        GymSplit[]
  gymLogs          GymLog[]
  budgetCategories BudgetCategory[]
  transactions     Transaction[]
  calendarEvents   CalendarEvent[]
  projects         Project[]
  resumeData       ResumeData?

  @@map("users")
}

// ─── Profile ──────────────────────────────────────────────────────────────────

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  dob        String? // stored as YYYY-MM-DD string
  gender     String?
  city       String?
  occupation String?
  heightCm   Float?   @map("height_cm")
  weightKg   Float?   @map("weight_kg")
  bio        String?
  // IANA zone (e.g. "Asia/Kolkata"). Defines which midnight a loggedDate means —
  // without this, late-night logs land on the wrong day.
  timezone   String   @default("UTC")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Habits ───────────────────────────────────────────────────────────────────

model Habit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  icon       String?
  color      String?
  frequency  String   @default("daily") // daily | weekly | custom
  targetDays Json?    @map("target_days") // [0,1,2,3,4,5,6] — day indices
  sortOrder  Int      @default(0) @map("sort_order")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id         String   @id @default(uuid())
  habitId    String   @map("habit_id")
  userId     String   @map("user_id")
  loggedDate String   @map("logged_date") // YYYY-MM-DD
  completed  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, loggedDate])
  @@map("habit_logs")
}

// ─── Gym ──────────────────────────────────────────────────────────────────────

model GymSplit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @default("My Split")
  days      Json // array of { title, muscles, exercises[] }
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymLogs GymLog[]

  @@map("gym_splits")
}

model GymLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  splitId     String?  @map("split_id")
  workoutDate String   @map("workout_date") // YYYY-MM-DD
  dayIndex    Int?     @map("day_index") // which day of the split (0–6)
  exercises   Json // [{ name, sets: [{ reps, weight, done }] }]
  notes       String?
  durationMin Int?     @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  split GymSplit? @relation(fields: [splitId], references: [id], onDelete: SetNull)

  @@map("gym_logs")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model BudgetCategory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  type         String // income | expense
  color        String?
  budgetAmount Float?   @map("budget_amount")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("budget_categories")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  categoryId    String?  @map("category_id")
  amount        Float
  description   String?
  date          String // YYYY-MM-DD
  type          String // income | expense
  recurring     Boolean  @default(false)
  recurringFreq String?  @map("recurring_freq") // monthly | weekly | yearly
  createdAt     DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  allDay      Boolean   @default(false) @map("all_day")
  color       String?
  recurrence  Json? // { rule: 'weekly', days: [1,3,5] } etc
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// ─── Work / Projects ──────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  status      String   @default("active") // active | on-hold | completed | archived
  priority    String? // high | medium | low
  deadline    String? // YYYY-MM-DD
  color       String?
  tasks       Json? // [{ id, title, done, dueDate }]
  notes       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ─── Resume ───────────────────────────────────────────────────────────────────

model ResumeData {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  sections  Json // { experience: [], education: [], skills: [], links: {} }
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume_data")
}

// ─── Metric Engine ────────────────────────────────────────────────────────────
// Replaces Habit/HabitLog. Design notes:
//  • History is FROZEN: each log snapshots `targetAtLog` + a computed `score`,
//    so changing a target never re-scores the past and the grid needs no joins.
//  • Streaks and repair-token balances are DERIVED from logs, never stored —
//    no cache-invalidation bugs.
//  • One row per (metric, day). `value` is the day TOTAL; repeated quantity
//    taps accumulate via an atomic increment.

enum MetricType {
  BINARY // one tap                       → 1 | 0
  QUANTITY // number + unit (3L water)      → min(value/target, 1.25)
  DURATION // minutes (90m deep work)       → min(value/target, 1.25)
  SCALE // 1–5 tap (sleep quality)       → value/5
  DERIVED // no input; computed from other modules
}

enum LogSource {
  MANUAL // user entered
  DERIVED // auto-written by gym/focus/finance hooks
  REPAIR // streak repair token spent — rendered as a hollow ring
}

model MetricDef {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  name          String
  type          MetricType
  unit          String?
  icon          String?
  color         String?
  target        Float? // CURRENT target; past days keep targetAtLog
  targetDays    Json?      @map("target_days") // [0..6]; days off are SKIPPED, never streak-breaking
  derivedSource String?    @map("derived_source") // "gym.session" | "focus.context:MATH-204"
  sortOrder     Int        @default(0) @map("sort_order")
  archived      Boolean    @default(false)
  createdAt     DateTime   @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs MetricLog[]

  @@index([userId, archived])
  @@map("metric_defs")
}

model MetricLog {
  id          String    @id @default(uuid())
  defId       String    @map("def_id")
  userId      String    @map("user_id")
  loggedDate  String    @map("logged_date") // YYYY-MM-DD in the user's timezone
  value       Float // day total
  targetAtLog Float?    @map("target_at_log") // snapshot of the rule this day was judged by
  score       Float // denormalized 0..1.25, computed at write
  source      LogSource @default(MANUAL)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  def  MetricDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([defId, loggedDate]) // idempotent upsert key — safe offline replay
  @@index([userId, loggedDate]) // the only index the grid needs
  @@map("metric_logs")
}

// ─── Weekly planning & study ──────────────────────────────────────────────────
// Modelled as queryable rows rather than a blob so the server can answer
// questions like "how many hours were planned vs actually studied per category".

model TimetableBlock {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dayIndex  Int      @map("day_index") // 0 = Monday .. 6 = Sunday
  startHour Int      @map("start_hour") // inclusive, 0–23
  endHour   Int      @map("end_hour") // exclusive, 1–24
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayIndex])
  @@map("timetable_blocks")
}

model WeeklyTask {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dayIndex  Int      @map("day_index") // 0 = Monday .. 6 = Sunday
  name      String
  category  String   @default("general") // user-defined, lowercase
  status    String   @default("pending") // pending | completed | critical | idle
  done      Boolean  @default(false)
  deadline  String? // YYYY-MM-DD
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayIndex])
  @@map("weekly_tasks")
}

model StudySession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String // YYYY-MM-DD in the user's timezone
  startTime String?  @map("start_time") // HH:MM
  minutes   Int
  category  String   @default("general") // lowercase, user-defined
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("study_sessions")
}
