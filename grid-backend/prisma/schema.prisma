// The Grid — Prisma Schema
// Run `npm run db:generate` after changes
// Run `npm run db:migrate` to create a migration

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooled URL (port 6543) — used at runtime
  directUrl = env("DIRECT_URL") // Supabase direct URL (port 5432) — used for migrations
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String?
  googleId         String?   @unique @map("google_id")
  passwordHash     String?   @map("password_hash")
  // Sandbox ("demo") accounts: real rows, real API path, no signup friction.
  // Claimable into a permanent account; prunable once expired.
  isSandbox        Boolean   @default(false) @map("is_sandbox")
  sandboxExpiresAt DateTime? @map("sandbox_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  profile          UserProfile?
  habits           Habit[]
  habitLogs        HabitLog[]
  metricDefs       MetricDef[]
  metricLogs       MetricLog[]
  timetableBlocks  TimetableBlock[]
  weeklyTasks      WeeklyTask[]
  studySessions    StudySession[]
  gymSplits        GymSplit[]
  gymLogs          GymLog[]
  healthDaily      HealthDaily[]
  healthSleep      HealthSleep[]
  healthToken      HealthToken?
  runActivities    RunActivity[]
  mealPresets      MealPreset[]
  foodLogs         FoodLog[]
  waterLogs        WaterLog[]
  nutritionTargets NutritionTargets?
  budgetCategories BudgetCategory[]
  transactions     Transaction[]
  calendarEvents   CalendarEvent[]
  projects         Project[]
  resumeData       ResumeData?

  @@map("users")
}

// ─── Profile ──────────────────────────────────────────────────────────────────

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  dob        String? // stored as YYYY-MM-DD string
  gender     String?
  city       String?
  occupation String?
  heightCm   Float?   @map("height_cm")
  weightKg   Float?   @map("weight_kg")
  bio        String?
  // IANA zone (e.g. "Asia/Kolkata"). Defines which midnight a loggedDate means —
  // without this, late-night logs land on the wrong day.
  timezone   String   @default("UTC")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

// ─── Habits ───────────────────────────────────────────────────────────────────

model Habit {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  name       String
  icon       String?
  color      String?
  frequency  String   @default("daily") // daily | weekly | custom
  targetDays Json?    @map("target_days") // [0,1,2,3,4,5,6] — day indices
  sortOrder  Int      @default(0) @map("sort_order")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@map("habits")
}

model HabitLog {
  id         String   @id @default(uuid())
  habitId    String   @map("habit_id")
  userId     String   @map("user_id")
  loggedDate String   @map("logged_date") // YYYY-MM-DD
  completed  Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, loggedDate])
  @@map("habit_logs")
}

// ─── Gym ──────────────────────────────────────────────────────────────────────

model GymSplit {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @default("My Split")
  days      Json // array of { title, muscles, exercises[] }
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gymLogs GymLog[]

  @@map("gym_splits")
}

model GymLog {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  splitId     String?  @map("split_id")
  workoutDate String   @map("workout_date") // YYYY-MM-DD
  dayIndex    Int?     @map("day_index") // which day of the split (0–6)
  exercises   Json // [{ name, sets: [{ reps, weight, done }] }]
  notes       String?
  durationMin Int?     @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  split GymSplit? @relation(fields: [splitId], references: [id], onDelete: SetNull)

  @@map("gym_logs")
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model BudgetCategory {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  name         String
  type         String // income | expense
  color        String?
  budgetAmount Float?   @map("budget_amount")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("budget_categories")
}

model Transaction {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  categoryId    String?  @map("category_id")
  amount        Float
  description   String?
  date          String // YYYY-MM-DD
  type          String // income | expense
  recurring     Boolean  @default(false)
  recurringFreq String?  @map("recurring_freq") // monthly | weekly | yearly
  createdAt     DateTime @default(now()) @map("created_at")

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category BudgetCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("transactions")
}

// ─── Calendar ─────────────────────────────────────────────────────────────────

model CalendarEvent {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  title       String
  description String?
  startTime   DateTime  @map("start_time")
  endTime     DateTime? @map("end_time")
  allDay      Boolean   @default(false) @map("all_day")
  color       String?
  recurrence  Json? // { rule: 'weekly', days: [1,3,5] } etc
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// ─── Work / Projects ──────────────────────────────────────────────────────────

model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  title       String
  description String?
  status      String   @default("active") // active | on-hold | completed | archived
  priority    String? // high | medium | low
  deadline    String? // YYYY-MM-DD
  color       String?
  tasks       Json? // [{ id, title, done, dueDate }]
  notes       String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// ─── Resume ───────────────────────────────────────────────────────────────────

model ResumeData {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  sections  Json // { experience: [], education: [], skills: [], links: {} }
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resume_data")
}

// ─── Metric Engine ────────────────────────────────────────────────────────────
// Replaces Habit/HabitLog. Design notes:
//  • History is FROZEN: each log snapshots `targetAtLog` + a computed `score`,
//    so changing a target never re-scores the past and the grid needs no joins.
//  • Streaks and repair-token balances are DERIVED from logs, never stored —
//    no cache-invalidation bugs.
//  • One row per (metric, day). `value` is the day TOTAL; repeated quantity
//    taps accumulate via an atomic increment.

enum MetricType {
  BINARY // one tap                       → 1 | 0
  QUANTITY // number + unit (3L water)      → min(value/target, 1.25)
  DURATION // minutes (90m deep work)       → min(value/target, 1.25)
  SCALE // 1–5 tap (sleep quality)       → value/5
  DERIVED // no input; computed from other modules
}

enum LogSource {
  MANUAL // user entered
  DERIVED // auto-written by gym/focus/finance hooks
  REPAIR // streak repair token spent — rendered as a hollow ring
}

model MetricDef {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  name          String
  type          MetricType
  unit          String?
  icon          String?
  color         String?
  target        Float? // CURRENT target; past days keep targetAtLog
  targetDays    Json?      @map("target_days") // [0..6]; days off are SKIPPED, never streak-breaking
  derivedSource String?    @map("derived_source") // "gym.session" | "focus.context:MATH-204"
  sortOrder     Int        @default(0) @map("sort_order")
  archived      Boolean    @default(false)
  createdAt     DateTime   @default(now()) @map("created_at")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs MetricLog[]

  @@index([userId, archived])
  @@map("metric_defs")
}

model MetricLog {
  id          String    @id @default(uuid())
  defId       String    @map("def_id")
  userId      String    @map("user_id")
  loggedDate  String    @map("logged_date") // YYYY-MM-DD in the user's timezone
  value       Float // day total
  targetAtLog Float?    @map("target_at_log") // snapshot of the rule this day was judged by
  score       Float // denormalized 0..1.25, computed at write
  source      LogSource @default(MANUAL)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  def  MetricDef @relation(fields: [defId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([defId, loggedDate]) // idempotent upsert key — safe offline replay
  @@index([userId, loggedDate]) // the only index the grid needs
  @@map("metric_logs")
}

// ─── Weekly planning & study ──────────────────────────────────────────────────
// Modelled as queryable rows rather than a blob so the server can answer
// questions like "how many hours were planned vs actually studied per category".

model TimetableBlock {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dayIndex  Int      @map("day_index") // 0 = Monday .. 6 = Sunday
  startHour Int      @map("start_hour") // inclusive, 0–23
  endHour   Int      @map("end_hour") // exclusive, 1–24
  label     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayIndex])
  @@map("timetable_blocks")
}

model WeeklyTask {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  dayIndex  Int      @map("day_index") // 0 = Monday .. 6 = Sunday
  name      String
  category  String   @default("general") // user-defined, lowercase
  status    String   @default("pending") // pending | completed | critical | idle
  done      Boolean  @default(false)
  deadline  String? // YYYY-MM-DD
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayIndex])
  @@map("weekly_tasks")
}

model StudySession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      String // YYYY-MM-DD in the user's timezone
  startTime String?  @map("start_time") // HH:MM
  minutes   Int
  category  String   @default("general") // lowercase, user-defined
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, category])
  @@map("study_sessions")
}

// ─── Health (Google Health / Fitbit Air) ──────────────────────────────────────

// One row per user per local date. All metric columns are nullable: a day can
// be partially synced, and derived scores are filled in by GRID, not Google.
model HealthDaily {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  date           String // YYYY-MM-DD in the user's timezone
  restingHr      Int?     @map("resting_hr")
  hrvMs          Float?   @map("hrv_ms")
  spo2Avg        Float?   @map("spo2_avg")
  spo2Min        Float?   @map("spo2_min")
  skinTempDelta  Float?   @map("skin_temp_delta") // °C vs personal baseline
  breathingRate  Float?   @map("breathing_rate")
  steps          Int?
  distanceM      Float?   @map("distance_m")
  caloriesTotal  Int?     @map("calories_total")
  caloriesActive Int?     @map("calories_active")
  azmMinutes     Int?     @map("azm_minutes")
  sedentaryMin   Int?     @map("sedentary_min")
  cardioLoad     Float?   @map("cardio_load") // GRID-calculated unless Google exposes it
  readiness      Int? // GRID-calculated 0–100
  hrZones        Json?    @map("hr_zones") // { outOfRange, fatBurn, cardio, peak } minutes
  intraday       Json? // optional { hr: [[min,bpm]...], stepsByHour: [24] }
  source         String   @default("google_health")
  syncedAt       DateTime @default(now()) @map("synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("health_daily")
}

model HealthSleep {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  date          String // wake-up date, YYYY-MM-DD
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  minutesAsleep Int      @map("minutes_asleep")
  minutesAwake  Int?     @map("minutes_awake")
  lightMin      Int?     @map("light_min")
  deepMin       Int?     @map("deep_min")
  remMin        Int?     @map("rem_min")
  efficiency    Float?
  score         Int? // GRID-calculated unless Google exposes it
  sleepingHr    Int?     @map("sleeping_hr")
  stages        Json? // [{ type, start, end }]
  source        String   @default("google_health")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, startTime])
  @@index([userId, date])
  @@map("health_sleep")
}

// Refresh token is stored encrypted (AES-256-GCM, key in HEALTH_TOKEN_KEY env).
model HealthToken {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  refreshTokenEnc String    @map("refresh_token_enc")
  scopes          String?
  lastSyncAt      DateTime? @map("last_sync_at")
  lastSyncStatus  String?   @map("last_sync_status")
  lastSyncError   String?   @map("last_sync_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_tokens")
}

// ─── Runs (Strava file imports) ───────────────────────────────────────────────

model RunActivity {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  date         String // YYYY-MM-DD local
  startTime    DateTime @map("start_time")
  name         String?
  distanceM    Float    @map("distance_m")
  movingSec    Int      @map("moving_sec")
  elapsedSec   Int?     @map("elapsed_sec")
  avgHr        Int?     @map("avg_hr")
  maxHr        Int?     @map("max_hr")
  cadence      Int?
  elevGainM    Float?   @map("elev_gain_m")
  calories     Int?
  gear         String?
  splits       Json? // [{ km, sec, hr, elevDelta }]
  hrZones      Json?    @map("hr_zones") // { z1..z5 } seconds
  bestEfforts  Json?    @map("best_efforts") // { "1000": sec, "1609": sec, "5000": sec, ... } fastest window per distance
  route        Json? // simplified polyline [[lat,lon]...]
  streams      Json? // downsampled { dist, pace, hr, ele, cad } for detail charts
  fileHash     String   @map("file_hash")
  sourceFormat String   @map("source_format") // fit | gpx | tcx | csv
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fileHash])
  @@index([userId, date])
  @@map("run_activities")
}

// ─── Nutrition ────────────────────────────────────────────────────────────────

// Saved meal shortcuts: type "S1" and the saved macros are logged.
model MealPreset {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  code        String // uppercase, unique per user, e.g. "S1"
  name        String
  serving     String?
  calories    Int
  protein     Float    @default(0)
  carbs       Float    @default(0)
  fat         Float    @default(0)
  defaultSlot String?  @map("default_slot") // breakfast | lunch | dinner | snack
  color       String?
  favorite    Boolean  @default(false)
  useCount    Int      @default(0) @map("use_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs FoodLog[]

  @@unique([userId, code])
  @@map("meal_presets")
}

model FoodLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  date       String // YYYY-MM-DD
  slot       String // breakfast | lunch | dinner | snack
  name       String
  serving    String?
  qty        Float    @default(1)
  calories   Int
  protein    Float    @default(0)
  carbs      Float    @default(0)
  fat        Float    @default(0)
  presetId   String?  @map("preset_id")
  presetCode String?  @map("preset_code")
  confidence String   @default("exact") // exact | estimated | rough
  createdAt  DateTime @default(now()) @map("created_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  preset MealPreset? @relation(fields: [presetId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("food_logs")
}

model WaterLog {
  id     String @id @default(uuid())
  userId String @map("user_id")
  date   String
  ml     Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("water_logs")
}

model NutritionTargets {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  waterMl   Int      @default(3000) @map("water_ml")
  plan      Json? // inputs + BMR/TDEE snapshot for the Methodology card
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_targets")
}
